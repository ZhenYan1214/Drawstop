# Copy to .env (gitignored) and fill in. KEY=value, no quotes, no spaces around "=".

# Funded Sepolia TEST wallet: lender, registry owner, deployer. Needed only for --broadcast and deployments.
CRE_ETH_PRIVATE_KEY=

# Companies House REST API key (Live environment), free at https://developer.company-information.service.gov.uk/
CH_API_KEY_VAR=

# demo/run-demo.sh only: the fictional borrower's wallet, and an arbiter ADDRESS different from the lender's
DEMO_BORROWER_PRIVATE_KEY=
DEMO_ARBITER_ADDRESS=
# Optional: lets the demo show arbiter actions (reviews, office-holder nomination)
DEMO_ARBITER_PRIVATE_KEY=
